{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#0b1220" },
        { "slug": "accent", "name": "Accent", "color": "#c81e1e" },
        { "slug": "navy", "name": "Navy", "color": "#14325c" },
        { "slug": "paper", "name": "Paper", "color": "#f3f5f8" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" }
      ]
    },
    "layout": {
      "contentSize": "780px",
      "wideSize": "1180px"
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Be Vietnam Pro\", system-ui, sans-serif",
          "name": "Be Vietnam Pro",
          "slug": "be-vietnam"
        },
        {
          "fontFamily": "\"Source Serif 4\", Georgia, serif",
          "name": "Source Serif 4",
          "slug": "source-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        }
      }
    }
  }
}
